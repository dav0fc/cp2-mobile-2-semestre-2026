# Variaveis da API (configurar so na hospedagem, nunca no repo)
# Projeto do Firebase
FIREBASE_PROJECT_ID=seu-project-id
# Email da conta de servico do Firebase Admin SDK
FIREBASE_CLIENT_EMAIL=sua-conta-de-servico@seu-project-id.iam.gserviceaccount.com
# Chave privada da conta de servico (com as quebras de linha \n)
FIREBASE_PRIVATE_KEY=CONFIGURAR_APENAS_NA_HOSPEDAGEM
# Porta do servidor (a hospedagem costuma definir sozinha)
PORT=3001
