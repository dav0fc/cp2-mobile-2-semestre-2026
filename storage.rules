rules_version = '2';
// Regras do Firebase Storage (fotos de perfil e de grupo)
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: so o dono sobe na propria pasta; leitura aberta
    // para autenticados (as fotos aparecem nas conversas)
    match /users/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Foto do grupo: qualquer autenticado pode subir (a checacao de
    // propriedade fica nas regras do Firestore, que so deixam o dono
    // gravar a URL no documento do grupo)
    match /groups/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
