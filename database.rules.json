{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$cid": {
        ".validate": "newData.hasChildren(['participants', 'createdAt'])"
      }
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$cid": {
        "$mid": {
          ".validate": "newData.hasChildren(['senderId', 'receiverId', 'text', 'createdAt']) && newData.child('text').val().length > 0 && newData.child('text').val().length <= 1000"
        }
      }
    }
  }
}
