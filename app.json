{
  "expo": {
    "name": "FrutigerChat",
    "slug": "frutigachat",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "frutigachat",
    "backgroundColor": "#FFFFFF",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-notifications",
      "expo-image-picker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frutigachat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.frutigachat"
    }
  }
}
