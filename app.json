{
  "expo": {
    "name": "FrutigerChat",
    "slug": "frutigachat",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "frutigachat",
    "backgroundColor": "#FFFFFF",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-notifications",
      "expo-image-picker"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frutigachat"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.dav0fc.frutigerchat",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "eb39bfb4-c050-4872-aa37-e581bdb059af"
      }
    }
  }
}
